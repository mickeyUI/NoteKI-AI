FAILURE_CACHE_MAX_ITEMS=1000
RATE_LIMIT=30/minute
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LINK_PREVIEW_USER_AGENT=LinkPreviewBot/1.0 (+https://github.com/second-brain-project)
